CREATE TABLE PESSOA (
	ID SERIAL PRIMARY KEY NOT NULL,
	NOME VARCHAR NOT NULL,
	EMAIL VARCHAR,
	TELEFONE VARCHAR NOT NULL,
	TIPO VARCHAR NOT NULL
);

CREATE TABLE FUNCIONARIOS(
    ID_PESSOA  INTEGER PRIMARY KEY,
    CPF VARCHAR NOT NULL,
    SETOR VARCHAR NOT NULL,
    SALARIO NUMERIC(10, 2) NOT NULL,
    TURNO VARCHAR NOT NULL,
    CONSTRAINT FK_FUNCIONARIO
    FOREIGN KEY (ID_PESSOA )
    REFERENCES PESSOA (ID)
);

CREATE TABLE FORNECEDOR (
	ID_PESSOA  INTEGER PRIMARY KEY,
    	CNPJ VARCHAR NOT NULL,
CONSTRAINT FK_FORNECEDOR
 FOREIGN KEY (ID_PESSOA )
 REFERENCES PESSOA (ID)
);

CREATE TABLE CLIENTE(
	ID_PESSOA  INTEGER PRIMARY KEY,
    	CPF VARCHAR NOT NULL,
CONSTRAINT FK_CLIENTE
 FOREIGN KEY (ID_PESSOA )
 REFERENCES PESSOA (ID)
);

CREATE TABLE CAIXA_DA_AGUA (
	ID SERIAL PRIMARY KEY NOT NULL,
	MARCA VARCHAR NOT NULL,
	MODELO VARCHAR NOT NULL,
	DIMENSAO DOUBLE PRECISION[] NOT NULL,
	COR VARCHAR NOT NULL,
	MATERIAL VARCHAR NOT NULL,
FORMATO VARCHAR NOT NULL,
PRECO NUMERIC(10, 2) NOT NULL
);

CREATE TABLE SALDO (
    ID SERIAL PRIMARY KEY NOT NULL,
    VLR_MOV NUMERIC(10, 2) NOT NULL,
    SALDO NUMERIC(10, 2) NOT NULL,
    DATA TIMESTAMP WITH TIME ZONE NOT NULL
);

CREATE TABLE MOVIMENTACAO (
	ID SERIAL PRIMARY KEY NOT NULL,
	VALOR NUMERIC(10, 2) NOT NULL,
	ID_PAGADOR INTEGER NOT NULL,
	CONSTRAINT FK_PAGADOR FOREIGN KEY (ID_PAGADOR) REFERENCES PESSOA(ID),
    ID_RECEBEDOR INTEGER NOT NULL,
	CONSTRAINT FK_RECEBEDOR FOREIGN KEY (ID_RECEBEDOR) REFERENCES PESSOA(ID),
	DATA_MOV TIMESTAMP WITH TIME ZONE NOT NULL,
	DESCRICAO VARCHAR,
	ID_RESPONSAVEL INTEGER NOT NULL,
	CONSTRAINT FK_RESPONSAVEL FOREIGN KEY (ID_RESPONSAVEL) REFERENCES PESSOA(ID),
	ID_SALDO INTEGER NOT NULL,
	CONSTRAINT FK_SALDO FOREIGN KEY (ID_SALDO) REFERENCES SALDO(ID)
);

CREATE TABLE VENDA (
	ID SERIAL PRIMARY KEY NOT NULL,
	ID_PRODUTO INTEGER NOT NULL,
	CONSTRAINT FK_PRODUTOS
        	FOREIGN KEY (ID_PRODUTO )
        	REFERENCES CAIXA_DA_AGUA(ID),
	QTDE INTEGER NOT NULL,
	VLR_UNITARIO NUMERIC(10, 2) NOT NULL,
	VLR_TOTAL NUMERIC(10, 2) NOT NULL,
	ID_CLIENTE INTEGER NOT NULL,
	CONSTRAINT FK_CLIENTES
        	FOREIGN KEY (ID_CLIENTE  )
        	REFERENCES PESSOA(ID),
	ID_RESPONSAVEL INTEGER NOT NULL,
	CONSTRAINT FK_RESPONSAVEL
        	FOREIGN KEY (ID_RESPONSAVEL)
        	REFERENCES PESSOA(ID),
	DATA TIMESTAMP WITH TIME ZONE NOT NULL,
	ID_MOV INTEGER NOT NULL,
    CONSTRAINT FK_VENDA FOREIGN KEY (ID_MOV) REFERENCES MOVIMENTACAO(ID)
);

CREATE TABLE COMPRA(
	ID SERIAL PRIMARY KEY NOT NULL,
	ID_PRODUTO INTEGER NOT NULL,
	CONSTRAINT FK_PRODUTOS
        	FOREIGN KEY (ID_PRODUTO )
        	REFERENCES CAIXA_DA_AGUA(ID),
	QTDE INTEGER NOT NULL,
	VLR_UNITARIO NUMERIC(10, 2) NOT NULL,
	VLR_TOTAL NUMERIC(10, 2) NOT NULL,
	ID_FORNECEDOR INTEGER NOT NULL,
	CONSTRAINT FK_FORNECEDOR
        	FOREIGN KEY (ID_FORNECEDOR)
        	REFERENCES PESSOA(ID),
	ID_RESPONSAVEL INTEGER NOT NULL,
	CONSTRAINT FK_RESPONSAVEL
        	FOREIGN KEY (ID_RESPONSAVEL)
        	REFERENCES PESSOA(ID),
	DATA TIMESTAMP WITH TIME ZONE NOT NULL,
	ID_MOV INTEGER NOT NULL,
    CONSTRAINT FK_COMPRA FOREIGN KEY (ID_MOV) REFERENCES MOVIMENTACAO(ID)
);

CREATE TABLE FOLHA_FUNCIONARIO (
	ID SERIAL PRIMARY KEY NOT NULL,
	ID_FUNCIONARIO INTEGER NOT NULL,
	CONSTRAINT FK_FUNCIONARIO
        	FOREIGN KEY (ID_FUNCIONARIO )
        	REFERENCES PESSOA(ID),
	VALOR NUMERIC(10, 2) NOT NULL,
	ID_RESPONSAVEL INTEGER NOT NULL,
	CONSTRAINT FK_RESPONSAVEL
        	FOREIGN KEY (ID_RESPONSAVEL)
        	REFERENCES PESSOA(ID),
	DATA TIMESTAMP WITH TIME ZONE NOT NULL,
	ID_MOV INTEGER NOT NULL,
	CONSTRAINT FK_FOLHA FOREIGN KEY (ID_MOV) REFERENCES MOVIMENTACAO(ID)

);

CREATE TABLE estoque (
	ID SERIAL PRIMARY KEY NOT NULL,
	MOVIMENTO INTEGER NOT NULL,
	QTDE_ATUAL INTEGER NOT NULL,
	ID_PRODUTO INTEGER NOT NULL,
	CONSTRAINT FK_PRODUTO FOREIGN KEY (ID_PRODUTO) REFERENCES CAIXA_DA_AGUA(ID),
	DATA TIMESTAMP WITH TIME ZONE NOT NULL,
	ID_MOV INTEGER NOT NULL,
	CONSTRAINT FK_ESTOQUE FOREIGN KEY (ID_MOV) REFERENCES MOVIMENTACAO(ID)
);